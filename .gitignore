# ==============================================================================
#                      Python & Package Management
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
eggs/

# Installer logs & reports
pip-log.txt
.coverage
.cache
htmlcov/


# ==============================================================================
#                      Virtual Environments
# ==============================================================================
# Ignore all common virtual environment folders.
.env
.venv
env/
venv/
ENV/


# ==============================================================================
#                      Django Specific
# ==============================================================================
# Local database file for SQLite (we don't use it, but good practice to ignore).
db.sqlite3
db.sqlite3-journal

# Log files.
*.log

# Project-specific folders generated by Django or our configuration.
# The leading '/' ensures we only ignore these folders at the project root.
/backend/staticfiles/
/backend/mediafiles/
/backend/logs/
/logs/

# ==============================================================================
#                      Docker Specific
# ==============================================================================
# Ignore the persistent data volume for our PostgreSQL database.
/postgres_data/


# ==============================================================================
#                      OS & Editor Specific
# ==============================================================================

# macOS
.DS_Store
config.toml

# VS Code
.vscode/
settings.json

# .agents Claude Code bridge + graphify output (regenerated locally, never commit)
/CLAUDE.md
/.claude/agents/
/.claude/commands/
/.claude/skills/
/.claude/settings.local.json
/graphify-out/

# .agents session anchor — host-specific, never committed (agents.md §5 state_anchor)
# docs/active_state.json IS tracked: it carries code_containers, topology_map
# and the audit history that docs_freshness_check.py reads, and start_workflow
# treats its absence as 'first pipeline session' — so ignoring it makes every
# fresh clone look like an un-onboarded repository.

# .agents session-state crash-recovery mirror of docs/active_state.json — same
# jurisdiction, same reason: host-specific, never committed.
/.agent_state/

# Local MCP server wiring, regenerated by .agents/scripts/install_claude.sh —
# host-specific, not needed by users of the Django template itself.
/.mcp.json

# Local identity/branding config for README generation (owner name, email,
# social links) — host-specific, may hold real personal contact info once filled in.
/identity.config.json

# Ruff's own cache directory (it self-manages via a nested .gitignore, this is
# a defensive belt-and-suspenders entry at the root).
.ruff_cache/

# .agents telemetry — strictly ephemeral by its own governance rule
# (agents.md §4 ephemeral_memory), never committed.
/memory/
